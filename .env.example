# Copy to .env and adjust. Never commit the real .env file.
EDP_DATABASE_URL=postgresql://edp:change-me@localhost:5432/edp
POSTGRES_PASSWORD=change-me

# Docker Compose only: host port for PostgreSQL, and the user the pipeline
# container runs as (use `id -u` / `id -g` on Linux so bind mounts stay writable).
POSTGRES_PORT=5432
HOST_UID=10001
HOST_GID=10001

EDP_LANDING_DIR=data/landing
EDP_REPORT_DIR=reports
# Timezone applied to naive timestamps from source systems (IANA name).
EDP_SOURCE_TIMEZONE=Europe/London
EDP_LOG_LEVEL=INFO
# json for log shippers, text for local reading.
EDP_LOG_FORMAT=json
# warn: load files with unexpected columns and record a warning. reject: refuse them.
EDP_SCHEMA_DRIFT_POLICY=warn
# Reject a whole file when more than this share of rows fail validation.
EDP_MAX_REJECT_RATE=0.25
EDP_MAX_RETRIES=3
EDP_RETRY_BASE_DELAY_S=0.5

# Tests: a disposable database that the integration suite drops and recreates.
EDP_TEST_DATABASE_URL=postgresql://edp:change-me@localhost:5432/edp_test
